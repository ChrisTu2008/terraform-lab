variable "project_name" {
  description = "Name prefix for resources in this lab"
  type        = string
  default     = "tf-week1"

  validation {
    condition     = can(regex("^[a-z0-9-]+$", var.project_name))
    error_message = "project_name may contain lowercase letters, numbers, and hyphens only."
  }
}

variable "host_port" {
  description = "Host port mapped to Nginx port 80"
  type        = number
  default     = 8080

  validation {
    condition     = var.host_port >= 1024 && var.host_port <= 65535
    error_message = "host_port must be between 1024 and 65535."
  }
}
